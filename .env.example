# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，不要提交。
DEEPSEEK_API_KEY=

# 可选。可用模型见 curl https://api.deepseek.com/models
# deepseek-v4-flash（默认，快且便宜） / deepseek-v4-pro（更强更贵）
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选。配音音色。换之前先跑 scripts/preview_voice.py 试听。
# zh-CN-YunyangNeural  男声 Professional/Reliable 播报腔（默认）
# zh-CN-XiaoxiaoNeural 女声 Warm 温暖
TTS_VOICE=zh-CN-YunyangNeural

# 可选。背景音乐，相对 video/public/。先跑 scripts/make_bgm.py 生成。
# bgm/ink.mp3（默认，有一点旋律） / bgm/dusk.mp3（纯低音垫，最不抢戏）
# 留空则不加背景音乐。
BGM_SRC=bgm/ink.mp3
